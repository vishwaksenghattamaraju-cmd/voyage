# =====================================================================
# Voyage AI - Multi-Agent Travel Planner Configuration
# =====================================================================
#
# Choose your preferred LLM Provider:
# Options: "auto" (default), "rule_based", "gemini", "groq", "openai", or "mock"
#
# - "auto": Automatically detects which API key is configured below.
#           If no key is configured, it falls back to the pure-Python rule-based engine.
# - "rule_based": Pure-Python offline multi-agent engine ($0 cost, 100% offline, no API key needed).
# - "gemini": Free tier via Google AI Studio (recommended free option).
# - "groq":   Free high-speed tier via Groq Cloud (recommended free option).
# - "openai": Paid tier via OpenAI API (gpt-4o-mini).
# - "mock":   Local offline demonstration mode (no API key needed, zero cost).
#
LLM_PROVIDER=auto

# Optional: Force offline demo mode regardless of configured keys (true/false)
DEMO_MODE=false

# ---------------------------------------------------------------------
# Option 1 (Free): Google Gemini
# Get a free API key at: https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------
# Option 2 (Free): Groq (Fast open-source models like Llama 3.3)
# Get a free API key at: https://console.groq.com/keys
# ---------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# ---------------------------------------------------------------------
# Option 3 (Paid): OpenAI
# Get an API key at: https://platform.openai.com/api-keys
# ---------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here

# =====================================================================
# Worldwide Tourist Destination Database (Zero-Cost Local Atlas)
# =====================================================================
# Voyage AI includes a comprehensive, built-in database of worldwide tourist
# destinations across Asia, Europe, North America, South America, Africa, and
# Oceania. 100% offline, $0 cost, zero external API keys needed.
#

# =====================================================================
# Production Persistent Cloud Database (Free Tier via Supabase)
# =====================================================================
# Required for permanent trip persistence on Vercel across redeployments
# and serverless cold starts.
#
# Setup instructions:
# 1. Create a free account & project at https://supabase.com ($0 / month free tier)
# 2. In your Supabase Dashboard -> SQL Editor, run the script in supabase/schema.sql
#
# 3. In your Supabase Project Settings -> API, copy:
#    - Project URL -> SUPABASE_URL
#    - service_role key (recommended for backend serverless) -> SUPABASE_SERVICE_ROLE_KEY
#    - (Or anon key) -> SUPABASE_KEY
#
# 4. If deploying to Vercel, set these in Vercel Project -> Settings -> Environment Variables.
# 5. If omitted locally, Voyage AI defaults to local trips.json.
#
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_KEY=your_supabase_anon_key_here
